{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/wildfires/api/:path*",
      "destination": "https://rcl-wildfires.colby-cb6.workers.dev/api/:path*"
    },
    {
      "source": "/wildfires/share/:path*",
      "destination": "https://rcl-wildfires.colby-cb6.workers.dev/share/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.redcrowlabs.com"
        }
      ],
      "destination": "https://redcrowlabs.com/:path*",
      "permanent": true
    }
  ]
}
